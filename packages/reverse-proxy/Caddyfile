http://localhost:5001 {
    log {
        # format single_field common_log
        output file ./caddy_logs/access.log
    }

    encode gzip

    # JSON APIs
    handle /api/movies* {
        reverse_proxy movies:4000
    }

    handle /api/rentals* {
        reverse_proxy rental:4001
    }

    handle /api/accounts* {
        reverse_proxy accounting:4002
    }

    # HTML pages, each rendered by the bounded context that owns them
    handle /rentals* {
        reverse_proxy rental:4001
    }

    handle /account* {
        reverse_proxy accounting:4002
    }

    # static files shared by all pages (CSS, htmx, images)
    @static path /assets/* /images/* /favicon.ico
    handle @static {
        root * {$STATIC_ROOT:../web-ui/public}
        file_server
    }

    # everything else: /, /movie-selection, /movie/:id/viewing
    handle {
        reverse_proxy movies:4000
    }
}
